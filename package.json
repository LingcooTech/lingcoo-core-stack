{
  "name": "lingcoo-core-stack",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted core platform for auth, billing, license, event and API services.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "build:admin": "npm run build --prefix admin-ui",
    "build:all": "npm run build:packages && npm run build:admin && npm run build",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:mvp": "node scripts/run-seed-mvp.cjs",
    "app:import": "node scripts/run-import-app-product.cjs",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "lint:admin": "npm run lint --prefix admin-ui",
    "typecheck:admin": "npm run typecheck --prefix admin-ui",
    "smoke:admin-static": "node scripts/verify-admin-static.mjs",
    "check": "npm run build:packages && npm run format:check && npm run check:boundaries && npm run lint && npm run lint:admin && npm run typecheck && npm run typecheck:test && npm run typecheck:admin && npm test && npm run build:all && npm run smoke:admin-static",
    "inspect:architecture": "node scripts/inspect-architecture.mjs",
    "db:bootstrap": "node dist/scripts/bootstrap-admin.js",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "settings:rotate": "node dist/scripts/rotate-settings-keys.js",
    "build:packages": "npm run build --workspace @lingcoo/contracts && npm run build --workspace @lingcoo/api-client",
    "test:e2e": "node scripts/run-e2e-tests.mjs",
    "smoke:production": "node scripts/verify-production-image.mjs",
    "predev": "npm run build:packages",
    "predev:worker": "npm run build:packages",
    "test:admin": "npm run test --prefix admin-ui"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "10.2.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "6.0.4",
    "@fastify/static": "10.1.5",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "6.1.1",
    "@lingcoo/contracts": "0.1.0",
    "@types/qrcode": "^1.5.6",
    "alipay-sdk": "^4.14.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-plugin": "^5.0.1",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.8.1",
    "nodemailer": "10.0.13",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "admin-ui",
    "packages/*"
  ],
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    },
    "tsx": {
      "esbuild": "0.28.2"
    }
  }
}
