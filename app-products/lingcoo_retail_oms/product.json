{
  "schemaVersion": 1,
  "app": {
    "code": "lingcoo_retail_oms",
    "name": "Lingcoo Retail OMS",
    "tagline": "独立部署的零售订单与运营系统",
    "description": "镜像交付，包含 Web、Admin、API、Worker 和 PostgreSQL。",
    "category": "retail",
    "type": "web_app",
    "status": "inactive",
    "meta": {
      "deliveryMode": "one_click",
      "onboardingStatus": "acceptance_pending",
      "deploymentModes": ["self_hosted", "managed"],
      "managedHostingStatus": "runtime_dns_tls_verified",
      "hostingProfile": {
        "enabled": true,
        "domainField": "primaryDomain",
        "resources": {
          "cpuMillis": 1000,
          "memoryMb": 1024,
          "diskMb": 10240
        },
        "monitoring": {
          "projectPrefix": "retail",
          "services": ["api", "worker", "web", "postgres", "caddy"],
          "backupRequired": true,
          "offsiteRequired": true
        },
        "httpChecks": ["/health/ready", "/health/worker", "/", "/admin/"]
      }
    }
  },
  "features": [
    {
      "code": "lingcoo_retail_oms_deployment",
      "name": "Retail OMS 部署交付权益",
      "kind": "boolean",
      "status": "active"
    }
  ],
  "plans": [
    {
      "code": "lingcoo_retail_oms_self_hosted",
      "name": "Retail OMS 自部署",
      "billingProvider": "wechat_pay",
      "priceAmount": 1,
      "currency": "CNY",
      "interval": "one_time",
      "status": "inactive",
      "featureCodes": ["lingcoo_retail_oms_deployment"],
      "meta": {
        "deploymentPolicy": {
          "maxActiveDeployments": 1,
          "domainBindingMode": "lock_on_first_success",
          "domainBindingSource": "primaryDomain",
          "domainBindingScope": "exact_host",
          "allowMultiplePurchases": false
        },
        "acceptanceOnlyPrice": true
      }
    }
  ],
  "offers": [
    {
      "code": "self_hosted_acceptance",
      "planCode": "lingcoo_retail_oms_self_hosted",
      "title": "Retail OMS 自部署验收商品",
      "description": "1 分钱仅用于隔离验收，正式价格待确定。",
      "badge": "待验收",
      "priceAmount": 1,
      "currency": "CNY",
      "isDefault": true,
      "status": "inactive"
    }
  ],
  "delivery": {
    "manifest": {
      "version": "1",
      "installer": {
        "repoUrl": "https://downloads.lingcoo.com/apps/lingcoo_retail_oms/pending/",
        "repoBranch": "release",
        "remoteInstallScriptUrl": "https://downloads.lingcoo.com/apps/lingcoo_retail_oms/pending/remote-install.sh",
        "installPath": "/opt/lingcoo-retail-oms"
      },
      "groups": [],
      "domainSlots": [
        {
          "key": "retail",
          "label": "Retail OMS 域名",
          "envKey": "RETAIL_DOMAIN",
          "sourceField": "primaryDomain",
          "required": true,
          "description": "Web、Admin 和 API 共用部署域名。"
        }
      ],
      "envFields": [
        {
          "key": "APP_IMAGE",
          "label": "Retail 运行镜像 digest",
          "type": "text",
          "scope": "preset",
          "required": true,
          "editable": true,
          "advanced": true
        },
        {
          "key": "ACR_USERNAME",
          "label": "镜像仓库只读用户名",
          "type": "text",
          "scope": "preset",
          "required": true,
          "editable": true,
          "advanced": true
        },
        {
          "key": "INITIAL_ADMIN_EMAIL",
          "label": "安装初始化邮箱",
          "type": "email",
          "scope": "user_input",
          "required": true,
          "editable": true,
          "advanced": false
        }
      ],
      "secretFields": [
        {
          "key": "ACR_PASSWORD",
          "label": "镜像仓库受限拉取凭据",
          "type": "secret",
          "scope": "preset",
          "required": true,
          "editable": true,
          "advanced": true
        },
        {
          "key": "INITIAL_ADMIN_PASSWORD",
          "label": "安装初始化密码",
          "type": "secret",
          "scope": "user_input",
          "required": true,
          "editable": true,
          "advanced": false
        }
      ],
      "assets": [
        {
          "key": "retail-runtime",
          "label": "Retail OMS Runtime",
          "type": "docker_image",
          "required": true,
          "visibility": "private",
          "imageEnv": "APP_IMAGE",
          "authSecret": "ACR_PASSWORD"
        }
      ],
      "notes": [
        "交付包仅包含部署配置和脚本，业务源码不交付。",
        "Web 是 SSR；Worker 持续运行；当前只认证自有服务器 Compose 模式。",
        "部署后的应用账号与使用不接入 Stack。"
      ]
    },
    "settings": {
      "values": {
        "APP_IMAGE": "PENDING_APPROVED_IMAGE_DIGEST",
        "ACR_USERNAME": "PENDING_SCOPED_REGISTRY_USER"
      },
      "secretsFromEnv": {
        "ACR_PASSWORD": "RETAIL_OMS_ACR_PASSWORD"
      },
      "installer": {
        "repoUrl": "https://downloads.lingcoo.com/apps/lingcoo_retail_oms/pending/",
        "repoBranch": "release"
      }
    }
  }
}
