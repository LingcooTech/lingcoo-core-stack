NODE_ENV=development
APP_NAME=fd-core-stack
APP_VERSION=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_GLOBAL_WINDOW=1 minute
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
CADDY_SITE_ADDRESS=:80
SETTINGS_ENCRYPTION_KEY=
# Production requires an independent encryption key of at least 32 characters.
# For rotation use CURRENT_KEY_ID and JSON KEYS, retaining keys still referenced by data.
SETTINGS_ENCRYPTION_CURRENT_KEY_ID=
SETTINGS_ENCRYPTION_KEYS=
SETTINGS_ENCRYPTION_LEGACY_KEY=
ALLOW_LEGACY_SETTINGS_DECRYPTION=true
API_DOCS_ENABLED=false
FD_CORE_HTTP_PORT=18080
FD_CORE_HTTPS_PORT=18443
FD_CORE_RUNTIME_IMAGE=ghcr.io/futuredecade/fd-core-stack:latest

DATABASE_URL=postgres://fd_core:fd_core_password@postgres:5432/fd_core
REDIS_URL=redis://redis:6379
JWT_SECRET=change-this-to-a-long-random-string
# Browser sessions use HttpOnly cookies, expire after 7 days, and are revoked on password changes.
AUTH_SESSION_TTL_SECONDS=604800

POSTGRES_DB=fd_core
POSTGRES_USER=fd_core
POSTGRES_PASSWORD=fd_core_password

# 新配置默认关闭；在后台完成配置后启用。旧配置未设置此变量时保留原有行为。
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
# 微信支付公钥 PEM 或平台证书 PEM；公钥模式必须配置对应 ID
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PLATFORM_CERT=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
# 留空时使用 PUBLIC_BASE_URL + /v1/billing/providers/wechat/notify；生产需 HTTPS。
WECHAT_PAY_NOTIFY_URL=

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=./secrets/alipay-app-private-key.pem
ALIPAY_PUBLIC_KEY_PATH=./secrets/alipay-public-key.pem
ALIPAY_F2F_PAY=false
ALIPAY_KEY_TYPE=PKCS1
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=http://localhost:8080/v1/billing/providers/alipay/notify
ALIPAY_RETURN_URL=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# S3-compatible asset storage. Prefer encrypted Admin settings in production.
# Qiniu: use the actual S3 bucket name and regional endpoint from its console.
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_DEFAULT_PREFIX=stack/assets
# Optional public CDN origin; leave blank to stream through permission-checked asset URLs.
STORAGE_PUBLIC_BASE_URL=

ALERT_DISPATCH_INTERVAL_MS=60000
ALERTING_ENABLED=false
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_RECIPIENTS=
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_MIN_LEVEL=warning
ALERT_COOLDOWN_MINUTES=60

# Platform-managed instance address suffix (DNS automation is a later stage).
HOSTING_DOMAIN_SUFFIX=app.lingcoo.com

# Platform-only DNSPod authorization. Never distribute to nodes or app containers.
HOSTING_DNS_ZONE=lingcoo.com
# HOSTING_DNS_SECRET_ID=
# HOSTING_DNS_SECRET_KEY=
