NODE_ENV=development
APP_NAME=fd-core-stack
APP_VERSION=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_GLOBAL_WINDOW=1 minute
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
CADDY_SITE_ADDRESS=:80
SETTINGS_ENCRYPTION_KEY=
FD_CORE_HTTP_PORT=18080
FD_CORE_HTTPS_PORT=18443
FD_CORE_RUNTIME_IMAGE=ghcr.io/futuredecade/fd-core-stack:latest

DATABASE_URL=postgres://fd_core:fd_core_password@postgres:5432/fd_core
REDIS_URL=redis://redis:6379
JWT_SECRET=change-this-to-a-long-random-string

POSTGRES_DB=fd_core
POSTGRES_USER=fd_core
POSTGRES_PASSWORD=fd_core_password

WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_APP_SECRET=
WECHAT_PAY_KEY=
WECHAT_PAY_DISABLE_H5=false
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_NOTIFY_URL=http://localhost:8080/v1/billing/providers/wechat/notify

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=./secrets/alipay-app-private-key.pem
ALIPAY_PUBLIC_KEY_PATH=./secrets/alipay-public-key.pem
ALIPAY_F2F_PAY=false
ALIPAY_KEY_TYPE=PKCS1
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=http://localhost:8080/v1/billing/providers/alipay/notify
ALIPAY_RETURN_URL=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
